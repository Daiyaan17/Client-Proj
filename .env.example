# Environment variables for Venus Electrical Trading Co
# In production on Vercel, set these in Project Settings > Environment Variables

# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Choose model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Shop WhatsApp number for direct orders (international format without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919840000000
